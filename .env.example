# ==============================================================================
# GeoSentinel AI - Enterprise Environment Configuration Template
# ==============================================================================

# Application Environment & Security
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="GeoSentinel Enterprise"
SECRET_KEY=change-this-to-a-cryptographically-secure-64-char-random-key-in-production
API_V1_STR=/api
FRONTEND_URL=http://localhost:5173

# Database Connection (Async SQLAlchemy)
# For local zero-setup dev (SQLite): sqlite+aiosqlite:///./geosentinel.db
# For Docker / Production (PostgreSQL): postgresql+asyncpg://geosentinel:geosentinel_secure_pass@postgres:5432/geosentinel_db
DATABASE_URL=sqlite+aiosqlite:///./geosentinel.db
POSTGRES_USER=geosentinel
POSTGRES_PASSWORD=geosentinel_secure_pass
POSTGRES_DB=geosentinel_db

# Redis & Celery Message Broker
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=geosentinel_redis_pass
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Ingestion Sources & Credentials
# RSS (BBC, Al Jazeera, UN, DW) and GDELT 2.0 work out of the box with zero API keys required
NEWSAPI_KEY=
MEDIASTACK_KEY=
GDELT_ENABLED=true
RSS_ENABLED=true
POLLING_INTERVAL_MINUTES=15

# Real-time Flash Alert External Webhooks (Optional)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOKS_ENABLED=false

# In-App Background Poller (Set to true for single-process local dev; set to false in multi-worker Celery production)
ENABLE_IN_APP_SCHEDULER=true

# Demo Mode (Loads verified baseline geopolitical articles if database is empty)
DEMO_MODE=true

# Mathematical Risk Scoring Engine Parameters:
# R_c(t) = min(100, (alpha / N) * sum(w_i * |S_i| * c_i * exp(-lambda * delta_t)))
ALPHA_SCALAR=4.25
DECAY_HALF_LIFE_DAYS=7.0
LAMBDA_DECAY=0.09902102579427789
OBSERVATION_WINDOW_DAYS=30
ALERT_CRITICAL_THRESHOLD=75.0
ALERT_COOLDOWN_HOURS=6

# Deduplication Engine (Two-Stage: Exact SHA-256 + MinHash 128 LSH)
MINHASH_PERMUTATIONS=128
LSH_THRESHOLD=0.82
DEDUP_WINDOW_HOURS=48

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]
