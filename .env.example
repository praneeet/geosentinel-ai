# ==============================================================================
# GeoSentinel AI - Environment Configuration Example
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
API_V1_STR=/api

# Database Connection (Async SQLAlchemy)
# For local zero-setup dev: sqlite+aiosqlite:///./geosentinel.db
# For Docker / PostgreSQL: postgresql+asyncpg://geosentinel:geosentinel_secure_pass@postgres:5432/geosentinel_db
DATABASE_URL=sqlite+aiosqlite:///./geosentinel.db
POSTGRES_USER=geosentinel
POSTGRES_PASSWORD=geosentinel_secure_pass
POSTGRES_DB=geosentinel_db

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Ingestion Sources & Credentials (optional: fallbacks enabled if empty)
NEWSAPI_KEY=
MEDIASTACK_KEY=
GDELT_ENABLED=true
RSS_ENABLED=true
POLLING_INTERVAL_MINUTES=15

# Academic Presentation / Demo Mode
# When true, realistic labeled sample geopolitical OSINT articles are loaded
DEMO_MODE=true

# Mathematical Risk Scoring Engine Parameters (as per Academic Synopsis Eq. 1)
# R_c(t) = min(100, alpha * sum(w_i * |S_i| * c_i * e^(-lambda * delta_t)))
ALPHA_SCALAR=4.25
DECAY_HALF_LIFE_DAYS=7.0
LAMBDA_DECAY=0.09902102579427789
OBSERVATION_WINDOW_DAYS=30
ALERT_CRITICAL_THRESHOLD=75.0
ALERT_COOLDOWN_HOURS=6

# Deduplication Engine (Two-Stage: SHA-256 + MinHash LSH)
MINHASH_PERMUTATIONS=128
LSH_THRESHOLD=0.82
DEDUP_WINDOW_HOURS=48

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]
